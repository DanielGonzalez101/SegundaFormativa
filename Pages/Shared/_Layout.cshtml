<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ASP.NET Repeater</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { background-color: #f0f4f8; }
        .navbar-custom { background-color: #1a73e8; }
        .footer-custom { background-color: #212529; color: #adb5bd; }
        .section-title { border-left: 4px solid #1a73e8; padding-left: 12px; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-page="/Index">🔄 ASP.NET Repeater</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">🏠 Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Repeater">📋 Repeater (Tabla)</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Cards">🃏 Cards</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Comparativa">⚖️ Comparativa</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom py-4 mt-5">
        <div class="container text-center">
            <p class="mb-1 fw-bold text-white">Universidad Autónoma del Caribe — ASP.NET</p>
            <p class="mb-0 small">Segunda Formativa · Sesión Abril 26 de 2026 · Control Repeater</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
